<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet author="straumat" id="1.2.0-table-queue_payment_to_update">

        <!-- Payment table - Store payment information -->
        <createTable tableName="QUEUE_PAYMENT_TO_UPDATE"
                     remarks="Queue of payments to update">

            <!-- Keys -->
            <column name="ID" type="BIGINT" remarks="Internal unique identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_QUEUE_PAYMENT_TO_UPDATE"/>
            </column>
            <column name="PAYMENT_ID" type="VARCHAR(255)" remarks="Unique payment id (usually the nonce)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="UNIQUE_QUEUE_PAYMENT_TO_UPDATE_PAYMENT_ID"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP" remarks="The timestamp of creation">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Auto increment on the unique identifier -->
        <addAutoIncrement tableName="QUEUE_PAYMENT_TO_UPDATE"
                          columnName="ID"
                          columnDataType="BIGINT"
                          startWith="10"/>

        <!-- Index on QUEUE_PAYMENT.CREATED_AT -->
        <createIndex indexName="INDEX_QUEUE_PAYMENT_CREATED_AT"
                     tableName="QUEUE_PAYMENT_TO_UPDATE">
            <column name="CREATED_AT"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>