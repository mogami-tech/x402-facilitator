<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet author="straumat" id="1.2.0-table-payment_step">

        <!-- Payment step table - Store payment steps -->
        <createTable tableName="PAYMENT_STEP"
                     remarks="Payment step">

            <!-- Keys -->
            <column name="ID" type="BIGINT" remarks="Internal unique identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PAYMENT_STEP"/>
            </column>
            <column name="PAYMENT_STEP_ID" type="VARCHAR(255)" remarks="Payment step ID">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="UNIQUE_PAYMENT_STEP_PAYMENT_ID"/>
            </column>

            <!-- Foreign keys -->
            <column name="FK_TENANT_ID" type="VARCHAR(255)" remarks="Tenant">
                <constraints nullable="false" foreignKeyName="PAYMENT_STEP_FK_TENANT_ID"
                             referencedTableName="TENANT"
                             referencedColumnNames="TENANT_ID"/>
            </column>
            <column name="FK_PAYMENT_ID" type="BIGINT" remarks="Corresponding payment">
                <constraints nullable="false" foreignKeyName="PAYMENT_STEP_FK_PAYMENT_ID"
                             referencedTableName="PAYMENT"
                             referencedColumnNames="ID"/>
            </column>

            <!-- Data -->
            <column name="PAYMENT_STEP_TYPE" type="VARCHAR(255)" remarks="Payment step type">
                <constraints nullable="false"/>
            </column>
            <column name="REQUEST_PAYLOAD" type="VARCHAR(8192)" remarks="Request payload sent to the facilitator"/>
            <column name="RESPONSE_PAYLOAD" type="VARCHAR(8192)" remarks="Response payload sent by the facilitator"/>
            <column name="ERROR_CODE" type="VARCHAR(255)" remarks="Optional error code returned by the facilitator"/>
            <column name="ERROR_MESSAGE" type="VARCHAR(255)"
                    remarks="Optional error message returned by the facilitator"/>

            <!-- Technical columns -->
            <column name="CREATED_AT" type="TIMESTAMP" remarks="The timestamp of creation">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="TIMESTAMP" remarks="The timestamp of last update"/>

        </createTable>

        <!-- Auto increment on the unique identifier -->
        <addAutoIncrement tableName="PAYMENT_STEP"
                          columnName="ID"
                          columnDataType="BIGINT"
                          startWith="10"/>

        <!-- Index on PAYMENT_STEP.PAYMENT_STEP_ID -->
        <createIndex indexName="INDEX_PAYMENT_STEP_PAYMENT_STEP_ID"
                     tableName="PAYMENT_STEP">
            <column name="PAYMENT_STEP_ID"/>
        </createIndex>

        <!-- Index on TENANT -->
        <createIndex indexName="INDEX_PAYMENT_STEP_FK_TENANT_ID"
                     tableName="PAYMENT_STEP">
            <column name="FK_TENANT_ID"/>
        </createIndex>

        <!-- Index on PAYMENT and CREATED_AT -->
        <createIndex indexName="INDEX_PAYMENT_STEP_PAYMENT_TO_PROCESS"
                     tableName="PAYMENT_STEP">
            <column name="FK_PAYMENT_ID"/>
            <column name="CREATED_AT"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>