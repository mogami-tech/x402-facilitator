<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet author="straumat" id="1.1.6-table-payment_trace">

        <!-- Payment trace table - Store payment trace information -->
        <createTable tableName="PAYMENT_TRACE"
                     remarks="Payment trace">

            <!-- Keys -->
            <column name="ID" type="BIGINT" remarks="Internal unique identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PAYMENT_TRACE"/>
            </column>
            <column name="PAYMENT_ID" type="VARCHAR(255)" remarks="Payment ID (Nonce usually)">
                <constraints nullable="false"/>
            </column>

            <!-- Foreign keys -->
            <column name="FK_TENANT_TENANT_ID" type="VARCHAR(255)" remarks="Tenant">
                <constraints nullable="false" foreignKeyName="FK_TENANT_TENANT_ID_PAYMENT"
                             referencedTableName="TENANT"
                             referencedColumnNames="TENANT_ID"/>
            </column>

        </createTable>

        <!-- Auto increment on the unique identifier -->
        <addAutoIncrement tableName="PAYMENT_TRACE"
                          columnName="ID"
                          columnDataType="BIGINT"
                          startWith="10"/>

        <!-- Index on PAYMENT_TRACE.PAYMENT_ID -->
        <createIndex indexName="INDEX_PAYMENT_TRACE_PAYMENT_ID"
                     tableName="PAYMENT_TRACE">
            <column name="PAYMENT_ID"/>
        </createIndex>

        <!-- Index on TENANT -->
        <createIndex indexName="INDEX_PAYMENT_TRACE_FK_TENANT_TENANT_ID"
                     tableName="PAYMENT_TRACE">
            <column name="FK_TENANT_TENANT_ID"/>
        </createIndex>

        <!-- Unique constraint on PAYMENT.FK_TENANT_TENANT_ID and PAYMENT.PAYMENT_ID -->
        <addUniqueConstraint tableName="PAYMENT_TRACE"
                             columnNames="FK_TENANT_TENANT_ID, PAYMENT_ID"
                             constraintName="UNIQUE_PAYMENT_TRACE_FK_TENANT_TENANT_ID_PAYMENT_ID">
        </addUniqueConstraint>

    </changeSet>
</databaseChangeLog>