<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet author="straumat" id="1.1.6-table-client">

        <createTable tableName="CLIENT"
                     remarks="Table containing client information">

            <!-- Keys -->
            <column name="ID" type="BIGINT" remarks="Internal unique identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CLIENT"/>
            </column>
            <column name="CLIENT_ID" type="VARCHAR(255)" remarks="Client ID">
                <constraints nullable="false" unique="true" uniqueConstraintName="UNIQUE_CLIENT_CLIENT_ID"/>
            </column>

            <!-- Individual or Corporation ? -->
            <column name="TYPE" type="VARCHAR(20)" remarks="INDIVIDUAL or CORPORATION">
                <constraints nullable="false"/>
            </column>

            <!-- Data for individuals -->
            <column name="FIRST_NAME" type="VARCHAR(255)" remarks="First name of individual"/>
            <column name="LAST_NAME" type="VARCHAR(255)" remarks="Last name of individual"/>

            <!-- Data for corporations -->
            <column name="COMPANY_NAME" type="VARCHAR(255)" remarks="Name of the company"/>

            <!-- Data common to all -->
            <column name="EMAIL" type="VARCHAR(255)" remarks="Contact email"/>

        </createTable>

        <!-- Auto increment on the unique identifier -->
        <addAutoIncrement tableName="CLIENT"
                          columnName="ID"
                          columnDataType="BIGINT"
                          startWith="10"/>

        <!-- Index on CLIENT.CLIENT_ID -->
        <createIndex indexName="INDEX_CLIENT_CLIENT_ID"
                     tableName="CLIENT">
            <column name="CLIENT_ID"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>