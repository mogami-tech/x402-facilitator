<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet author="straumat" id="1.1.6-table-payment">

        <!-- Payment table - Store payment information -->
        <createTable tableName="PAYMENT"
                     remarks="Payment">

            <!-- Keys -->
            <column name="ID" type="BIGINT" remarks="Internal unique identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PAYMENT"/>
            </column>
            <column name="PAYMENT_ID" type="VARCHAR(255)" remarks="Unique payment id (usually the nonce)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UNIQUE_PAYMENT_PAYMENT_ID"/>
            </column>

            <!-- Foreign keys -->
            <column name="FK_TENANT_TENANT_ID" type="VARCHAR(255)" remarks="Tenant">
                <constraints nullable="false" foreignKeyName="PAYMENT_FK_TENANT_TENANT_ID"
                             referencedTableName="TENANT"
                             referencedColumnNames="TENANT_ID"/>
            </column>
            <column name="FK_ADDRESS_FROM_ADDRESS_ID" type="BIGINT" remarks="Source address">
                <constraints nullable="false" foreignKeyName="PAYMENT_FK_ADDRESS_FROM_ADDRESS_ID"
                             referencedTableName="ADDRESS"
                             referencedColumnNames="ID"/>
            </column>
            <column name="FK_ADDRESS_TO_ADDRESS_ID" type="BIGINT" remarks="Destination address">
                <constraints nullable="false" foreignKeyName="PAYMENT_FK_ADDRESS_TO_ADDRESS_ID"
                             referencedTableName="ADDRESS"
                             referencedColumnNames="ID"/>
            </column>

        </createTable>

        <!-- Auto increment on the unique identifier -->
        <addAutoIncrement tableName="PAYMENT"
                          columnName="ID"
                          columnDataType="BIGINT"
                          startWith="10"/>

        <!-- Index on PAYMENT_TRACE.PAYMENT_ID -->
        <createIndex indexName="INDEX_PAYMENT_PAYMENT_ID"
                     tableName="PAYMENT">
            <column name="PAYMENT_ID"/>
        </createIndex>

        <!-- Index on TENANT -->
        <createIndex indexName="INDEX_PAYMENT_FK_TENANT_TENANT_ID"
                     tableName="PAYMENT">
            <column name="FK_TENANT_TENANT_ID"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>